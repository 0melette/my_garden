{
  "filters": {
    "and": [
      "file.inFolder(\"Garden Notes/Plants\")",
      "kind == \"garden-plant\""
    ]
  },
  "properties": {
    "file.name": {
      "displayName": "Plant"
    },
    "note.category": {
      "displayName": "Garden group"
    },
    "note.sun": {
      "displayName": "Sunlight"
    },
    "note.water": {
      "displayName": "Water"
    },
    "note.planting_months": {
      "displayName": "Planting months"
    },
    "note.calendar_region": {
      "displayName": "Calendar region"
    },
    "note.growing": {
      "displayName": "In my garden"
    },
    "note.favourite": {
      "displayName": "Favourite"
    },
    "note.bed": {
      "displayName": "Bed or pot"
    },
    "note.spacing_cm": {
      "displayName": "Spacing · cm"
    }
  },
  "views": [
    {
      "type": "cards",
      "name": "Photo cards",
      "filters": {
        "and": [
          "growing == true"
        ]
      },
      "order": [
        "file.name",
        "plant",
        "growing",
        "favourite",
        "bed"
      ],
      "sort": [
        {
          "property": "file.name",
          "direction": "ASC"
        }
      ],
      "image": "note.photo",
      "imageFit": "cover",
      "imageAspectRatio": 0.65,
      "cardSize": 200
    },
    {
      "type": "table",
      "name": "Editable table",
      "filters": {
        "and": [
          "growing == true"
        ]
      },
      "order": [
        "file.name",
        "plant",
        "growing",
        "favourite",
        "bed"
      ],
      "sort": [
        {
          "property": "file.name",
          "direction": "ASC"
        }
      ]
    },
    {
      "type": "table",
      "name": "Choose my plants",
      "order": [
        "file.name",
        "plant",
        "growing",
        "favourite",
        "bed"
      ]
    },
    {
      "type": "cards",
      "name": "Favourites",
      "filters": {
        "and": [
          "favourite == true"
        ]
      },
      "order": [
        "file.name",
        "bed"
      ],
      "image": "note.photo",
      "imageAspectRatio": 0.65,
      "cardSize": 200
    }
  ]
}
